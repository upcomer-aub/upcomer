generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  courses   Course[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Professor {
  id        String            @id @default(cuid())
  name      String
  courses   CourseProfessor[]
  files     CourseFile[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Term {
  id        String       @id @default(cuid())
  name      String       @unique
  files     CourseFile[]
  // Added for US-34: advice scoped to a session (term).
  advice    Advice[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(STUDENT)
  // Profile (US-04), both optional and edited only by the user at /profile.
  facultyId           String?
  faculty             Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  major               String?
  sessions            Session[]
  enrollments         UserCourse[]
  submissions         CourseFile[]         @relation("SubmittedFiles")
  passwordResetTokens PasswordResetToken[]

  questionCorrections QuestionCorrection[]

  questionReports     QuestionReport[]     @relation("ReportedQuestions")
  closedReports       QuestionReport[]     @relation("ClosedQuestionReports")
  learningTopics      LearningTopic[]
  coveredTopics       CoveredTopic[]
  questionProgress    QuestionProgress[]
  learningEvents      LearningEvent[]
  generatedQuestions  GeneratedPracticeQuestion[]

  // Added for US-34: advice a student wrote, and advice an admin removed.
  advice              Advice[]             @relation("AdviceAuthored")
  removedAdvice       Advice[]             @relation("AdviceRemoved")
  adviceReports       AdviceReport[]       @relation("AdviceReporter")
  closedAdviceReports AdviceReport[]       @relation("AdviceReportClosedBy")
  // Added for US-40: advice the student marked helpful.
  adviceVotes         AdviceVote[]
  // Added for US-41: replies the student wrote beneath advice.
  adviceComments      AdviceComment[]
  // Added for US-45: the mock exams a student generated.
  mockExams           MockExam[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  answerKeysUpdated   AnswerKey[]          @relation("AnswerKeyUpdatedBy")

  @@index([facultyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A password reset link (US-03). Like Session, only the SHA-256 hash of the random token is stored. A link works once,
// until expiresAt, and only while it is the user's newest one; see lib/password-reset.ts.
model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  // Set when the password was changed with this link.
  usedAt        DateTime?
  // Set when a newer link replaced this one, or another link was used.
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserCourse {
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
  @@index([userId])
}

model Course {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  facultyId        String
  faculty          Faculty            @relation(fields: [facultyId], references: [id])
  professors       CourseProfessor[]
  files            CourseFile[]
  enrollments      UserCourse[]
  questionGroups   QuestionGroup[]
  corrections      QuestionCorrection[]
  questionReports  QuestionReport[]
  learningTopics   LearningTopic[]
  coveredTopics    CoveredTopic[]
  questionProgress QuestionProgress[]
  learningEvents   LearningEvent[]
  generatedQuestions GeneratedPracticeQuestion[]
  // Added for US-34.
  advice           Advice[]
  adviceReports    AdviceReport[]
  // Added for US-45.
  mockExams        MockExam[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  answerKeys       AnswerKey[]
}

model CourseProfessor {
  courseId    String
  professorId String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([courseId, professorId])
}

enum FileCategory {
  EXAM
  MATERIAL
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  OTHER
}

// Review state of a file (US-13). Only PUBLISHED files are shown to students or processed; see lib/submissions.ts.
enum FileStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model CourseFile {
  id               String              @id @default(cuid())
  courseId         String
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professorId      String?
  professor        Professor?          @relation(fields: [professorId], references: [id], onDelete: SetNull)
  title            String
  originalFileName String
  storageKey       String
  category         FileCategory
  year             Int?
  termId           String?
  term             Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  examType         ExamType?
  topic            String?
  mimeType         String?
  sizeBytes        Int?
  // Admin uploads and files from before US-13 are PUBLISHED; student submissions start as PENDING.
  status           FileStatus          @default(PUBLISHED)
  // The student who submitted the file; null for admin uploads.
  submittedById    String?
  submittedBy      User?               @relation("SubmittedFiles", fields: [submittedById], references: [id], onDelete: SetNull)
  // Shown to the submitter; set only when the status is REJECTED.
  rejectionReason  String?
  // When an admin published or rejected the submission.
  reviewedAt       DateTime?
  questions        Question[]
  processingRuns   FileProcessingRun[]
  // Added for US-34: advice scoped to an exam paper.
  advice           Advice[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([courseId, category])
  @@index([termId])
  @@index([status, createdAt])
  @@index([submittedById])
}

enum ProcessingStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProcessingStage {
  EXTRACTION
  GROUPING
}

model FileProcessingRun {
  id        String           @id @default(cuid())
  fileId    String
  file      CourseFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status    ProcessingStatus @default(RUNNING)
  stage     ProcessingStage  @default(EXTRACTION)
  reason    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([fileId, createdAt])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// One logged event (US-87). Context holds the logger's sanitized fields only.
model LogEntry {
  id        String   @id @default(cuid())
  level     LogLevel
  event     String
  context   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([event, createdAt])
}

// One question extracted from an exam paper (written by US-14's extraction). Its course is always the paper's course.
model Question {
  id                 String               @id @default(cuid())
  fileId             String
  file               CourseFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Position of the question in its paper, from 1.
  number             Int
  text               String
  groupId            String?
  group              QuestionGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Admin corrections (question corrections). They are kept when the question bank is rebuilt:
  // a pinned question always joins the group of the question it is pinned to, and a split question stays in a group of its own.
  pinnedToQuestionId String?
  pinnedTo           Question?            @relation("QuestionPin", fields: [pinnedToQuestionId], references: [id], onDelete: SetNull)
  pinnedQuestions    Question[]           @relation("QuestionPin")
  splitOut           Boolean              @default(false)
  // Admin exclusions survive processing and regrouping without deleting source/history.
  excludedFromBank   Boolean              @default(false)
  // Set when an admin corrected the extracted text.
  textCorrectedAt    DateTime?
  corrections        QuestionCorrection[]
  learningEvents     LearningEvent[]
  generatedQuestions GeneratedPracticeQuestion[]
  // Added for US-45: mock exam questions that record this source question (for US-49's learning events).
  mockExamQuestions  MockExamQuestion[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([fileId, number])
  @@index([groupId])
  @@index([pinnedToQuestionId])
}

enum CorrectionKind {
  EXCLUDE
  RESTORE
  EDIT_TEXT
  MOVE
  SPLIT
  RESET
}

// The activity log of admin corrections to extracted questions. Each row keeps a readable copy of what changed, so it still
// makes sense after the question, its paper, or the admin is deleted.
model QuestionCorrection {
  id             String         @id @default(cuid())
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionId     String?
  question       Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  adminId        String?
  admin          User?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  kind           CorrectionKind
  paperTitle     String
  questionNumber Int
  // EDIT_TEXT: the old and new text. MOVE: the old and new group's text. SPLIT and RESET: the old group's text.
  before         String?
  after          String?
  createdAt      DateTime       @default(now())

  @@index([courseId, createdAt])
  @@index([questionId, createdAt])
}

// Identical and near-identical questions of one course (US-15a), ranked by how many papers they appeared in (US-16).
// Rebuilt by rebuildQuestionBank in lib/question-bank.ts; the papers are the files of its questions.
model QuestionGroup {
  id             String             @id @default(cuid())
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The question as shown to students: the first source question, without its number or marks.
  text           String
  // Grouping key; unique per course, so a rebuild keeps each group's ID.
  normalizedText String
  // Distinct papers the question appeared in; a repeat inside one paper counts once.
  paperCount     Int
  // 1 is the most frequent question in the course.
  rank           Int
  questions      Question[]
  reports        QuestionReport[]
  progress       QuestionProgress[]
  // Added for US-34: advice scoped to a question.
  advice         Advice[]
  // Added for US-45: mock exam questions drawn from this group.
  mockExamQuestions MockExamQuestion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // The admin's answer key that mock exam answers are marked against (US-49); null when there is none.
  answerKey     AnswerKey?

  @@unique([courseId, normalizedText])
  @@index([courseId, rank])
}

// What a student says is wrong with a question on the Upcomer Exam (US-23).
enum QuestionReportReason {
  // Different questions shown as one, or one question shown twice.
  WRONG_GROUPING
  // The text is wrong, cut off, or garbled.
  WRONG_TEXT
  NOT_A_QUESTION
  OTHER
}

// OPEN reports are the admin queue at /admin/reports. Closing one (US-75) sets closedAt and closedById.
enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// One student's report of one question (US-23). The admin queue shows the open reports of a question as one item, and a
// student cannot open a second report of a question while their first is open; see lib/question-reports.ts.
model QuestionReport {
  id           String               @id @default(cuid())
  courseId     String
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null once a regroup removed the group; questionText still says what was reported.
  groupId      String?
  group        QuestionGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Null if the student's account was deleted.
  reporterId   String?
  reporter     User?                @relation("ReportedQuestions", fields: [reporterId], references: [id], onDelete: SetNull)
  // The question as the student saw it when reporting.
  questionText String
  reason       QuestionReportReason
  // Optional details from the student, at most 500 characters; shown to admins, never logged.
  note         String?
  status       QuestionReportStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  closedBy     User?                @relation("ClosedQuestionReports", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([groupId, status])
  @@index([reporterId])
  @@index([courseId])
}

// One topic of one student's learning profile in one course (US-33). The course is part of the key, so a change in one
// course never changes another's profile, and two courses with a topic of the same name track it separately.
// See lib/learning-profile.ts.
model LearningTopic {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The topic trimmed, with spacing collapsed and in lower case, so "TCP" and " tcp" are one topic within a course.
  topicKey  String
  // The topic as first written, for display.
  topic     String
  // How weak the student is, from 0 to 1. Confidence saves and performance events combine a two-observation prior
  // with actual correct/incorrect counts; see learning-evidence-rules.ts.
  weakness  Float
  // The student's own confidence rating, 1 (not confident) to 5 (very confident), from US-24. Null when the topic was
  // skipped, or when the row was written by other code (for example US-25) without a rating.
  confidence Int?
  // Confidence (or the pre-performance weakness) contributes two prior observations.
  baselineWeakness Float?
  correctCount Int @default(0)
  incorrectCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, courseId, topicKey])
  @@index([courseId])
}

// A topic a student marked as already covered in one course (US-32). A row means covered; undoing deletes it. It only
// leaves the topic out of the "Study next" recommendation. It is not evidence, so it is kept apart from LearningTopic:
// marking a topic never creates or changes a profile row.
model CoveredTopic {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The same key as LearningTopic.topicKey.
  topicKey  String
  createdAt DateTime @default(now())

  @@id([userId, courseId, topicKey])
  @@index([courseId])
}

// One question a student marked done on the Upcomer Exam (US-21). Only the student who marked it ever sees it.
// A regroup can replace a question's group with a new one (its first question changed). The mark is then kept with a
// null groupId and re-linked, within the same course only, to the group that now holds its questions; see
// lib/question-progress.ts.
model QuestionProgress {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null while a regroup has replaced the group and the mark is not re-linked yet.
  groupId           String?
  group             QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // The group's source questions when it was marked, its first question first; used to re-link the mark after a regroup.
  sourceQuestionIds String[]
  doneAt            DateTime       @default(now())

  @@unique([userId, groupId])
  @@index([userId, courseId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Advice from previous students (US-34, US-35, US-37, US-39). Added in migration 20261102000000_advice.
// ---------------------------------------------------------------------------------------------------------------------

// What a piece of advice is about (US-34). COURSE is advice for the whole course.
enum AdviceScopeKind {
  COURSE
  EXAM
  SESSION
  TOPIC
  QUESTION
}

// REMOVED advice is never shown to students or found by search; an admin removes it after a report (US-77).
enum AdviceStatus {
  VISIBLE
  REMOVED
}

// One piece of advice from a student to later students of a course (US-34). The author is always stored, so admins can
// handle abuse, but is never sent to student-facing views when isAnonymous is set (US-37); see lib/advice.ts.
// The scope's target (exam paper, session/term, question group) can be deleted later: its ID then becomes null and
// scopeLabel still says what the advice was about.
model Advice {
  id            String          @id @default(cuid())
  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null if the author's account was deleted.
  authorId      String?
  author        User?           @relation("AdviceAuthored", fields: [authorId], references: [id], onDelete: SetNull)
  isAnonymous   Boolean         @default(false)
  scopeKind     AdviceScopeKind
  // Readable copy of the scope (exam title, term name, topic, start of the question).
  scopeLabel    String
  fileId        String?
  file          CourseFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  termId        String?
  term          Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  groupId       String?
  group         QuestionGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Same normalization as LearningTopic.topicKey, so topic filters match case and spacing loosely.
  topicKey      String?
  topic         String?
  title         String
  body          String
  // US-35: an HTTPS link only, validated by parseResourceLink in lib/advice-rules.ts.
  resourceUrl   String?
  resourceTitle String?
  status        AdviceStatus    @default(VISIBLE)
  removedAt     DateTime?
  removedById   String?
  removedBy     User?           @relation("AdviceRemoved", fields: [removedById], references: [id], onDelete: SetNull)
  // Set when the author last edited the title, text, or link (US-36).
  editedAt      DateTime?
  reports       AdviceReport[]
  // Added for US-40: the students who marked it helpful.
  votes         AdviceVote[]
  // Added for US-41: the replies beneath it.
  comments      AdviceComment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([courseId, status, createdAt])
  @@index([courseId, topicKey])
  @@index([authorId])
  @@index([fileId])
  @@index([termId])
  @@index([groupId])
}

// What a student says is wrong with a piece of advice (US-43).
enum AdviceReportReason {
  // Insulting, harassing, or hateful.
  OFFENSIVE
  // Advertising, or not about the course.
  SPAM
  // Names or details of a person who did not agree to it.
  PERSONAL_INFO
  // Encourages cheating or breaking course rules.
  ACADEMIC_DISHONESTY
  OTHER
}

// OPEN reports wait for an admin (US-77). RESOLVED means the admin removed the advice; DISMISSED that they kept it.
enum AdviceReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// One student's report of one piece of advice (US-43). A student cannot open a second report of the same advice while
// their first is open (see lib/advice-reports.ts). Only admins see reports; the reporter is never shown to the author or
// to other students. The row is kept after the advice is removed, so the admin's decision stays on record. Added in
// migration 20261116000003_advice_reports.
model AdviceReport {
  id         String             @id @default(cuid())
  adviceId   String
  advice     Advice             @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null if the student's account was deleted.
  reporterId String?
  reporter   User?              @relation("AdviceReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     AdviceReportReason
  // Optional details from the student, at most 500 characters; shown to admins, never logged.
  note       String?
  status     AdviceReportStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  closedBy   User?              @relation("AdviceReportClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([adviceId, status])
  @@index([reporterId, status])
  @@index([courseId])
}

// One student marked one piece of advice as helpful (US-40). The primary key makes a second mark impossible; undoing
// deletes the row. Who voted is never shown to students, only the count; see lib/advice-votes.ts.
model AdviceVote {
  adviceId  String
  advice    Advice   @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([adviceId, userId])
  @@index([userId])
}

// One reply beneath a piece of advice (US-41), shown oldest first. Deleting the advice deletes its replies; a reply whose
// author deleted their account stays, shown as "Former student". The author ID is never sent to students: a reply by the
// post's own author is labelled "(author)", and on an anonymous post as "Anonymous student (author)"; see
// lib/advice-comments.ts. Only the reply's author or an admin can delete it.
model AdviceComment {
  id        String   @id @default(cuid())
  adviceId  String
  advice    Advice   @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([adviceId, createdAt])
  @@index([authorId])
}

enum LearningSource {
  QUESTION_BANK
  MOCK_EXAM
  FLASHCARD
  AI_INTERACTION
}

model LearningEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source LearningSource
  eventId String
  // Immutable producer target survives deletion of the source; replay must match it.
  targetKey String
  topicKey String
  topic String
  correct Boolean
  questionId String?
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  generatedQuestionId String?
  generatedQuestion GeneratedPracticeQuestion? @relation(fields: [generatedQuestionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, source, eventId])
  @@index([userId, courseId, topicKey])
  @@index([questionId])
  @@index([generatedQuestionId])
}

enum PracticeDifficulty {
  EASY
  MEDIUM
  HARD
}

// US-44: private generated tasks. Replacing/removing a source deletes these items. Editing source text invalidates
// its fingerprint so a future mock assembler cannot select stale content. Historical events keep their topic evidence.
model GeneratedPracticeQuestion {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceQuestionId String
  sourceQuestion Question @relation(fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  sourceFingerprint String
  topicKey String
  topic String
  difficulty PracticeDifficulty
  prompt String
  contentHash String
  generatorVersion String
  // Source exams have no answer keys: do not invent a rubric or an assessed result.
  rubric Json?
  learningEvents LearningEvent[]
  // Added for US-45: mock exam questions copied from this item.
  mockExamQuestions MockExamQuestion[]
  createdAt DateTime @default(now())

  @@unique([userId, courseId, contentHash])
  @@index([userId, courseId, difficulty])
  @@index([sourceQuestionId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Configurable mock exams (US-45). Added in migration 20261116000000_mock_exams.
// ---------------------------------------------------------------------------------------------------------------------

// EASY, MEDIUM and HARD are windows of the course's questions sorted by an estimated complexity (question length and number
// of parts; past papers carry no difficulty rating). MIXED spreads the picks over the whole range. See lib/mock-exam-rules.ts.
enum MockExamDifficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

// IN_PROGRESS: the student is sitting it and answers can be saved. SUBMITTED: answers are locked (grading is US-49).
enum MockExamStatus {
  IN_PROGRESS
  SUBMITTED
}

// What a mock exam's topic mix was weighted by (US-47). PROFILE: the student's weakness in each topic and each topic's exam
// frequency. NO_PROFILE: the student had no profile in the course, so exam frequency only. PROFILE_UNAVAILABLE: the profile
// could not be read, so exam frequency only.
enum MockExamMix {
  PROFILE
  NO_PROFILE
  PROFILE_UNAVAILABLE
}

// One mock exam a student generated for one course (US-45). Only its student ever sees it. The settings are kept, so an
// alternative version (US-46) can be generated with the same settings. Its questions are copied in, so the exam stays the
// same when the question bank is rebuilt; see lib/mock-exams.ts.
model MockExam {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The topics asked for (keys as in LearningTopic.topicKey, and their display names). Empty means every topic.
  topicKeys   String[]
  topics      String[]
  // The number of questions the exam has.
  length      Int
  // The number of questions asked for (US-45): larger than `length` when the chosen topics could not fill it. Null on
  // exams made before it was kept.
  requestedLength Int?
  // US-47: what the topic mix was weighted by (null on exams made before it), and the names of the student's weaker
  // topics the exam was weighted toward, weakest first, for the line on the exam page.
  mixBasis    MockExamMix?
  weakTopics  String[]           @default([])
  difficulty  MockExamDifficulty
  // The student asked for their generated practice questions (US-44) to be mixed in. Kept with the other settings (US-46).
  includeGenerated Boolean       @default(false)
  // US-46 (Lea Tass): an alternative version points at the original exam (version 1); every later version points at the
  // same original, so a family is the original and the exams linked to it. Null for an original. Added in migration
  // 20261119000000_mock_exam_versions; see lib/mock-exam-versions.ts.
  originalId  String?
  original    MockExam?          @relation("MockExamVersions", fields: [originalId], references: [id], onDelete: SetNull)
  versions    MockExam[]         @relation("MockExamVersions")
  status      MockExamStatus     @default(IN_PROGRESS)
  submittedAt DateTime?
  // US-48, timed mode: the time limit in minutes (null = untimed), when the student pressed Start, and the server's
  // deadline (startedAt + limit). `timedOut` marks an exam submitted because its time ran out, with the answers saved by
  // then; `submittedAt` is then the deadline.
  timeLimitMinutes Int?
  startedAt   DateTime?
  deadlineAt  DateTime?
  timedOut    Boolean            @default(false)

  // When the answers were marked (US-49); null until then. An exam is marked once.
  markedAt    DateTime?
  questions   MockExamQuestion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, courseId, createdAt])
  @@index([courseId])
  @@index([originalId])
}

// One question of a mock exam, in sitting order (1 is first). The text and the evidence are copies taken when the exam was
// generated; groupId says which question-bank group it came from and becomes null if a regroup removes that group.
model MockExamQuestion {
  id           String         @id @default(cuid())
  mockExamId   String
  mockExam     MockExam       @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  position     Int
  groupId      String?
  group        QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // A past-paper question: the group's source question when the exam was generated, chosen by sourceQuestionOf in
  // lib/mock-exam-rules.ts. US-49 records a MOCK_EXAM learning event with it. Null for a generated question, and if the
  // source question is deleted.
  questionId   String?
  question     Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  // A generated practice question (US-44): the item it was copied from. Null for a past-paper question, and if the item
  // is deleted (its source was replaced or removed).
  generatedQuestionId String?
  generatedQuestion   GeneratedPracticeQuestion? @relation(fields: [generatedQuestionId], references: [id], onDelete: SetNull)
  topicKey     String?
  topic        String?
  text         String
  // "Appeared in paperCount of totalPapers papers" when the exam was generated. A generated question has paperCount 0.
  paperCount   Int
  totalPapers  Int
  // Provenance: the papers the question came from, as "Title (year)".
  sourcePapers String[]
  // The student's saved answer; null while empty.
  answer       String?
  answeredAt   DateTime?
  // The marking (US-49), copied when the exam is marked, so a later change to the answer key never changes it. NO_KEY:
  // the question has no answer key (or is a generated question), so it was not marked and recorded no learning event.
  outcome       MarkOutcome?
  matchedPoints String[]     @default([])
  missedPoints  String[]     @default([])
  // Which key points were missed, then the admin's explanation; null when there is nothing to explain.
  feedback      String?
  markedAt      DateTime?

  @@unique([mockExamId, position])
  @@index([groupId])
  @@index([questionId])
  @@index([generatedQuestionId])
}

// How a mock exam answer was marked against its answer key (US-49); see lib/mock-marking-rules.ts.
enum MarkOutcome {
  CORRECT
  PARTIAL
  INCORRECT
  UNANSWERED
  NO_KEY
}

// The answer key of one question-bank group (US-49), written by an admin: the key points a full answer covers, and an
// explanation shown to students who miss one. Past papers come with no keys, so a question without one is never marked.
// Added in migration 20261116000004_mock_marking.
model AnswerKey {
  id          String        @id @default(cuid())
  groupId     String        @unique
  group       QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  keyPoints   String[]
  explanation String        @default("")
  updatedById String?
  updatedBy   User?         @relation("AnswerKeyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId])
}
