DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upcomer?schema=public"
FILE_STORAGE_ROOT="public/uploads"
ADMIN_EMAIL="admin@mail.aub.edu"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Upcomer Admin"
SIGNUP_EMAIL_DOMAIN=""
# Monitoring (US-87). Empty values use the defaults: alert after 5 errors within 10 minutes, at most one alert per 10 minutes.
ALERT_THRESHOLD=""
ALERT_WINDOW_MINUTES=""
ALERT_COOLDOWN_MINUTES=""
# A Discord-compatible webhook (https). Messages carry event names and counts only.
ALERT_WEBHOOK_URL=""
# Set to "off" to keep logs on the console only.
LOG_PERSIST=""
# Password reset emails (US-03). APP_URL is the site's public address for links in emails (for example
# "https://upcomer.example.com"); development falls back to http://localhost:3000. A mail provider is plugged in with
# MAIL_API_URL, MAIL_API_KEY, and MAIL_FROM: one JSON POST { from, to, subject, text } with a Bearer key, as Resend's API
# (MAIL_API_URL="https://api.resend.com/emails"). Left empty, development prints the email to the terminal (dev only) and
# production sends nothing.
APP_URL=""
MAIL_API_URL=""
MAIL_API_KEY=""
MAIL_FROM=""
# Reviews per admin per minute on /admin/submissions (US-74); empty means 60.
REVIEW_RATE_LIMIT_PER_MINUTE=""
# Question reports per student per minute on the Upcomer Exam (US-23); empty means 10.
QUESTION_REPORT_RATE_LIMIT_PER_MINUTE=""
