generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  courses   Course[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Professor {
  id        String            @id @default(cuid())
  name      String
  courses   CourseProfessor[]
  files     CourseFile[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Term {
  id        String       @id @default(cuid())
  name      String       @unique
  files     CourseFile[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(STUDENT)
  // Profile (US-04), both optional and edited only by the user at /profile.
  facultyId           String?
  faculty             Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  major               String?
  sessions            Session[]
  enrollments         UserCourse[]
  submissions         CourseFile[]         @relation("SubmittedFiles")
  passwordResetTokens PasswordResetToken[]

  questionCorrections QuestionCorrection[]

  questionReports     QuestionReport[]     @relation("ReportedQuestions")
  closedReports       QuestionReport[]     @relation("ClosedQuestionReports")
  learningTopics      LearningTopic[]
  questionProgress    QuestionProgress[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([facultyId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A password reset link (US-03). Like Session, only the SHA-256 hash of the random token is stored. A link works once,
// until expiresAt, and only while it is the user's newest one; see lib/password-reset.ts.
model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  // Set when the password was changed with this link.
  usedAt        DateTime?
  // Set when a newer link replaced this one, or another link was used.
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserCourse {
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
  @@index([userId])
}

model Course {

  id             String               @id @default(cuid())
  code           String               @unique
  name           String
  facultyId      String
  faculty        Faculty              @relation(fields: [facultyId], references: [id])
  professors     CourseProfessor[]
  files          CourseFile[]
  enrollments    UserCourse[]
  questionGroups QuestionGroup[]
  corrections    QuestionCorrection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  facultyId        String
  faculty          Faculty            @relation(fields: [facultyId], references: [id])
  professors       CourseProfessor[]
  files            CourseFile[]
  enrollments      UserCourse[]
  questionGroups   QuestionGroup[]
  questionReports  QuestionReport[]
  learningTopics   LearningTopic[]
  questionProgress QuestionProgress[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

}

model CourseProfessor {
  courseId    String
  professorId String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([courseId, professorId])
}

enum FileCategory {
  EXAM
  MATERIAL
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  OTHER
}

// Review state of a file (US-13). Only PUBLISHED files are shown to students or processed; see lib/submissions.ts.
enum FileStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model CourseFile {
  id               String              @id @default(cuid())
  courseId         String
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professorId      String?
  professor        Professor?          @relation(fields: [professorId], references: [id], onDelete: SetNull)
  title            String
  originalFileName String
  storageKey       String
  category         FileCategory
  year             Int?
  termId           String?
  term             Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  examType         ExamType?
  topic            String?
  mimeType         String?
  sizeBytes        Int?
  // Admin uploads and files from before US-13 are PUBLISHED; student submissions start as PENDING.
  status           FileStatus          @default(PUBLISHED)
  // The student who submitted the file; null for admin uploads.
  submittedById    String?
  submittedBy      User?               @relation("SubmittedFiles", fields: [submittedById], references: [id], onDelete: SetNull)
  // Shown to the submitter; set only when the status is REJECTED.
  rejectionReason  String?
  // When an admin published or rejected the submission.
  reviewedAt       DateTime?
  questions        Question[]
  processingRuns   FileProcessingRun[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([courseId, category])
  @@index([termId])
  @@index([status, createdAt])
  @@index([submittedById])
}

enum ProcessingStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProcessingStage {
  EXTRACTION
  GROUPING
}

model FileProcessingRun {
  id        String           @id @default(cuid())
  fileId    String
  file      CourseFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status    ProcessingStatus @default(RUNNING)
  stage     ProcessingStage  @default(EXTRACTION)
  reason    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([fileId, createdAt])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// One logged event (US-87). Context holds the logger's sanitized fields only.
model LogEntry {
  id        String   @id @default(cuid())
  level     LogLevel
  event     String
  context   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([event, createdAt])
}

// One question extracted from an exam paper (written by US-14's extraction). Its course is always the paper's course.
model Question {
  id                 String               @id @default(cuid())
  fileId             String
  file               CourseFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Position of the question in its paper, from 1.
  number             Int
  text               String
  groupId            String?
  group              QuestionGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Admin corrections (question corrections). They are kept when the question bank is rebuilt:
  // a pinned question always joins the group of the question it is pinned to, and a split question stays in a group of its own.
  pinnedToQuestionId String?
  pinnedTo           Question?            @relation("QuestionPin", fields: [pinnedToQuestionId], references: [id], onDelete: SetNull)
  pinnedQuestions    Question[]           @relation("QuestionPin")
  splitOut           Boolean              @default(false)
  // Set when an admin corrected the extracted text.
  textCorrectedAt    DateTime?
  corrections        QuestionCorrection[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([fileId, number])
  @@index([groupId])
  @@index([pinnedToQuestionId])
}

enum CorrectionKind {
  EDIT_TEXT
  MOVE
  SPLIT
  RESET
}

// The activity log of admin corrections to extracted questions. Each row keeps a readable copy of what changed, so it still
// makes sense after the question, its paper, or the admin is deleted.
model QuestionCorrection {
  id             String         @id @default(cuid())
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionId     String?
  question       Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  adminId        String?
  admin          User?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  kind           CorrectionKind
  paperTitle     String
  questionNumber Int
  // EDIT_TEXT: the old and new text. MOVE: the old and new group's text. SPLIT and RESET: the old group's text.
  before         String?
  after          String?
  createdAt      DateTime       @default(now())

  @@index([courseId, createdAt])
  @@index([questionId, createdAt])
}

// Identical and near-identical questions of one course (US-15a), ranked by how many papers they appeared in (US-16).
// Rebuilt by rebuildQuestionBank in lib/question-bank.ts; the papers are the files of its questions.
model QuestionGroup {
  id             String             @id @default(cuid())
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The question as shown to students: the first source question, without its number or marks.
  text           String
  // Grouping key; unique per course, so a rebuild keeps each group's ID.
  normalizedText String
  // Distinct papers the question appeared in; a repeat inside one paper counts once.
  paperCount     Int
  // 1 is the most frequent question in the course.
  rank           Int
  questions      Question[]
  reports        QuestionReport[]
  progress       QuestionProgress[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([courseId, normalizedText])
  @@index([courseId, rank])
}

// What a student says is wrong with a question on the Upcomer Exam (US-23).
enum QuestionReportReason {
  // Different questions shown as one, or one question shown twice.
  WRONG_GROUPING
  // The text is wrong, cut off, or garbled.
  WRONG_TEXT
  NOT_A_QUESTION
  OTHER
}

// OPEN reports are the admin queue at /admin/reports. Closing one (US-75) sets closedAt and closedById.
enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// One student's report of one question (US-23). The admin queue shows the open reports of a question as one item, and a
// student cannot open a second report of a question while their first is open; see lib/question-reports.ts.
model QuestionReport {
  id           String               @id @default(cuid())
  courseId     String
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null once a regroup removed the group; questionText still says what was reported.
  groupId      String?
  group        QuestionGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Null if the student's account was deleted.
  reporterId   String?
  reporter     User?                @relation("ReportedQuestions", fields: [reporterId], references: [id], onDelete: SetNull)
  // The question as the student saw it when reporting.
  questionText String
  reason       QuestionReportReason
  // Optional details from the student, at most 500 characters; shown to admins, never logged.
  note         String?
  status       QuestionReportStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  closedBy     User?                @relation("ClosedQuestionReports", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([groupId, status])
  @@index([reporterId])
  @@index([courseId])
}

// One topic of one student's learning profile in one course (US-33). The course is part of the key, so a change in one
// course never changes another's profile, and two courses with a topic of the same name track it separately.
// See lib/learning-profile.ts.
model LearningTopic {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The topic trimmed, with spacing collapsed and in lower case, so "TCP" and " tcp" are one topic within a course.
  topicKey  String
  // The topic as first written, for display.
  topic     String
  // How weak the student is in the topic, from 0 (strong) to 1 (weak). Written with setTopicWeakness; how it is worked out
  // (self-rating, US-24; performance, US-25) belongs to those stories.
  weakness  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, courseId, topicKey])
  @@index([courseId])
}

// One question a student marked done on the Upcomer Exam (US-21). Only the student who marked it ever sees it.
// A regroup can replace a question's group with a new one (its first question changed). The mark is then kept with a
// null groupId and re-linked, within the same course only, to the group that now holds its questions; see
// lib/question-progress.ts.
model QuestionProgress {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Null while a regroup has replaced the group and the mark is not re-linked yet.
  groupId           String?
  group             QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // The group's source questions when it was marked, its first question first; used to re-link the mark after a regroup.
  sourceQuestionIds String[]
  doneAt            DateTime       @default(now())

  @@unique([userId, groupId])
  @@index([userId, courseId])
  @@index([groupId])
}
