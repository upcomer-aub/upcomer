DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upcomer?schema=public"
FILE_STORAGE_ROOT="public/uploads"
ADMIN_EMAIL="admin@mail.aub.edu"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Upcomer Admin"
SIGNUP_EMAIL_DOMAIN=""
# Monitoring (US-87). Empty values use the defaults: alert after 5 errors within 10 minutes, at most one alert per 10 minutes.
ALERT_THRESHOLD=""
ALERT_WINDOW_MINUTES=""
ALERT_COOLDOWN_MINUTES=""
# A Discord-compatible webhook (https). Messages carry event names and counts only.
ALERT_WEBHOOK_URL=""
# Set to "off" to keep logs on the console only.
LOG_PERSIST=""
# Password reset emails (US-03). APP_URL is the site's public address for links in emails (for example
# "https://upcomer.example.com"); development falls back to http://localhost:3000. A mail provider is plugged in with
# MAIL_API_URL, MAIL_API_KEY, and MAIL_FROM: one JSON POST { from, to, subject, text } with a Bearer key, as Resend's API
# (MAIL_API_URL="https://api.resend.com/emails"). Left empty, development prints the email to the terminal (dev only) and
# production sends nothing.
APP_URL=""
MAIL_API_URL=""
MAIL_API_KEY=""
MAIL_FROM=""
# Reviews per admin per minute on /admin/submissions (US-74); empty means 60.
REVIEW_RATE_LIMIT_PER_MINUTE=""
# Question reports per student per minute on the Upcomer Exam (US-23); empty means 10.
QUESTION_REPORT_RATE_LIMIT_PER_MINUTE=""
# Questions marked done or undone per student per minute on the Upcomer Exam (US-21); empty means 60.
QUESTION_PROGRESS_RATE_LIMIT_PER_MINUTE=""
# Topic confidence saves per student per minute on /courses/:courseId/confidence (US-24); empty means 30.
TOPIC_CONFIDENCE_RATE_LIMIT_PER_MINUTE=""
# Topics marked covered or not covered per student per minute on /courses/:courseId/topics (US-32); empty means 30.
TOPIC_COVERED_RATE_LIMIT_PER_MINUTE=""
# Mock exams generated per student per hour on /courses/:courseId/mock-exams (US-45); empty means 20.
MOCK_EXAM_RATE_LIMIT_PER_HOUR=""
# Sprint 4: question-bank outcomes per student/minute (default 60); generated batches per student/minute (default 20).
PRACTICE_RATE_LIMIT_PER_MINUTE=""
PRACTICE_GENERATION_RATE_LIMIT_PER_MINUTE=""
# Admin replacement/removal requests per minute (default 20).
FILE_MANAGEMENT_RATE_LIMIT_PER_MINUTE=""
# Course advice feed (US-38): seconds a feed page stays cached (empty means 30, 0 turns it off); advice page reads per
# logged-in student per minute (empty means 120).
ADVICE_FEED_CACHE_SECONDS=""
ADVICE_FEED_RATE_LIMIT_PER_MINUTE=""
# Edits and deletes of one's own advice per student per minute (US-36); empty means 20.
ADVICE_CHANGE_RATE_LIMIT_PER_MINUTE=""
# Advice reports per student per minute (US-43); empty means 10.
ADVICE_REPORT_RATE_LIMIT_PER_MINUTE=""
# Admin decisions on reported advice per admin per minute (US-77); empty means 60.
ADVICE_MODERATION_RATE_LIMIT_PER_MINUTE=""
